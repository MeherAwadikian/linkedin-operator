# Copy to .env (gitignored). Names only — never commit real values.

# ---- Supabase (issue #2) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Worker-only. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Worker secrets vault (issue #5) ----
# 32-byte master key (base64). Lives ONLY in the worker .env. Never in DB/repo.
# Generate with: pnpm --filter @lo/worker exec tsx src/cli.ts generate-key
VAULT_MASTER_KEY=

# Shared token the web tier presents to the worker's local ingest endpoint.
# Set the SAME value in the web .env and the worker .env (any long random string).
WORKER_INGEST_TOKEN=

# ---- Worker runtime ----
WORKER_HEARTBEAT_MS=5000
WORKER_ID=worker-local
WORKER_INGEST_PORT=8787
# Playwright drives your installed Google Chrome (channel: chrome) — no download.
# Headful (default) so 2FA/checkpoint hand-offs are visible; set 1 for headless.
WORKER_HEADLESS=
# Persistent browser profile dir (keeps the LinkedIn session across restarts).
WORKER_BROWSER_DIR=

# ---- Web → worker (web .env) ----
# Where the web server reaches the worker's local ingest endpoint.
WORKER_INGEST_URL=http://127.0.0.1:8787

# ---- LLM (user-supplied; stored encrypted in DB via Settings, not here) ----
# ANTHROPIC_API_KEY is entered in the app UI and vaulted, not read from env.
